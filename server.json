// ============================================================
// MESSAGE HANDLER
// ============================================================

async function handleMessage(
    text,
    sender,
    sock,
    jid
) {
    if (
        typeof text !== "string" ||
        !sender ||
        !jid
    ) {
        return;
    }

    text = text.trim();

    if (!text) {
        return;
    }

    const user = getUser(sender);

    // --------------------------------------------
    // NON-COMMAND CHAT
    // --------------------------------------------

    if (!text.startsWith(":")) {
        const lower = text.toLowerCase();

        if (
            /\b(hi|hello|hey)\b/.test(lower)
        ) {
            return `Tch. You're here.`;
        }

        if (lower.includes("how are you")) {
            return `Functional. That's apparently enough.`;
        }

        if (
            lower === "bye" ||
            lower.includes("goodbye")
        ) {
            return `Tch. Finally, some peace.`;
        }

        if (lower.includes("hodekai")) {
            return getMixedResponse();
        }

        return null;
    }

    // --------------------------------------------
    // COMMAND
    // --------------------------------------------

    const command = text
        .slice(1)
        .trim();

    if (!command) {
        return menuBox();
    }

    const args = command.split(/\s+/);
    const main = args[0].toLowerCase();

    COMMAND_COUNTER++;

    // --------------------------------------------
    // INFO
    // --------------------------------------------

    if (main === "bot") {
        return botInfoBox();
    }

    if (main === "menu") {
        return menuBox();
    }

    if (
        main === "help" ||
        main === "commands"
    ) {
        return commandBox();
    }

    if (main === "members") {
        return `CONCLAVE members: ${getTotalMembers()}`;
    }

    if (main === "status") {
        const stats = getStats();

        return `
╭─〔 📊 STATUS 〕─╮
│ STATUS: ONLINE
│ MEMBERS: ${stats.members}
│ GUILDS: ${stats.guilds}
│ COMPANIES: ${stats.companies}
╰─〔 HODEKAI 〕─╯
`;
    }

    if (main === "ping") {
        return "🏓 Pong!";
    }

    // --------------------------------------------
    // PROFILE
    // --------------------------------------------

    if (main === "profile") {
        return `
╭─〔 👤 PROFILE 〕─╮
│ USER: ${sender}
│ ROLE: ${user.role}
│ WALLET: ${user.xenoShards} XS
│ BANK: ${user.bank} XS
│ TOTAL: ${user.xenoShards + user.bank} XS
│ WINS: ${user.wins}
│ JOINED: ${user.joinDate}
╰─〔 HODEKAI 〕─╯
`;
    }

    // --------------------------------------------
    // BALANCE
    // --------------------------------------------

    if (main === "bal") {
        return (
            `💰 Wallet: ${user.xenoShards} XS\n` +
            `🏦 Bank: ${user.bank} XS\n` +
            `Total: ${user.xenoShards + user.bank} XS`
        );
    }

    // --------------------------------------------
    // DAILY
    // --------------------------------------------

    if (main === "daily") {
        const today = new Date().toDateString();

        if (user.lastDaily === today) {
            return "You already claimed today's reward.";
        }

        user.lastDaily = today;

        giveXenoShards(
            sender,
            DAILY_XS
        );

        saveData();

        return (
            `🎁 Daily reward: +${DAILY_XS} XS.\n` +
            `Wallet: ${user.xenoShards} XS.`
        );
    }

    // --------------------------------------------
    // CHEQUE
    // --------------------------------------------

    if (main === "cheque") {
        const amount = parseAmount(args[1]);

        if (!amount) {
            return "Usage: :cheque <amount>";
        }

        if (amount > 100000) {
            return "Cheque limit is 100,000 XS.";
        }

        giveXenoShards(
            sender,
            amount
        );

        saveData();

        return `Cheque cleared: +${amount} XS.`;
    }

    // --------------------------------------------
    // PAY
    // --------------------------------------------

    if (main === "pay") {
        const target = args[1];
        const amount = parseAmount(args[2]);

        if (!target || !amount) {
            return "Usage: :pay <user> <amount>";
        }

        if (!takeXenoShards(sender, amount)) {
            return (
                `Insufficient funds. ` +
                `Wallet: ${user.xenoShards} XS.`
            );
        }

        getUser(target);

        giveXenoShards(
            target,
            amount
        );

        saveData();

        return `Sent ${amount} XS to ${target}.`;
    }

    // --------------------------------------------
    // TALK
    // --------------------------------------------

    if (main === "talk") {
        return random([
            "Yes, Father.",
            "I'm listening.",
            "You have my attention.",
            "Go on.",
            "Tch. Continue."
        ]);
    }

    // --------------------------------------------
    // PLAY
    // --------------------------------------------

    if (main === "play") {
        const song = command
            .slice(5)
            .trim();

        if (!song) {
            return "Usage: :play <song>";
        }

        return `🎵 Now playing: ${song}`;
    }

    // --------------------------------------------
    // BANK
    // --------------------------------------------

    if (main === "bank") {
        const sub =
            (args[1] || "").toLowerCase();

        if (
            sub === "dep" ||
            sub === "deposit"
        ) {
            const amount =
                parseAmount(args[2]);

            if (!amount) {
                return "Usage: :bank dep <amount>";
            }

            if (
                !takeXenoShards(
                    sender,
                    amount
                )
            ) {
                return (
                    `You only have ` +
                    `${user.xenoShards} XS in your wallet.`
                );
            }

            user.bank += amount;

            saveData();

            return (
                `Deposited ${amount} XS.\n` +
                `Bank: ${user.bank} XS.`
            );
        }

        if (
            sub === "wit" ||
            sub === "withdraw"
        ) {
            const amount =
                parseAmount(args[2]);

            if (!amount) {
                return "Usage: :bank wit <amount>";
            }

            if (user.bank < amount) {
                return (
                    `You only have ` +
                    `${user.bank} XS in your bank.`
                );
            }

            user.bank -= amount;

            giveXenoShards(
                sender,
                amount
            );

            saveData();

            return (
                `Withdrew ${amount} XS.\n` +
                `Wallet: ${user.xenoShards} XS.`
            );
        }

        if (
            sub === "bal" ||
            sub === "balance"
        ) {
            return (
                `Wallet: ${user.xenoShards} XS\n` +
                `Bank: ${user.bank} XS\n` +
                `Total: ${user.xenoShards + user.bank} XS`
            );
        }

        return commandBox();
    }

    // --------------------------------------------
    // ADMIN
    // --------------------------------------------

    if (main === "admin") {
        if (!isAdmin(sender)) {
            return "Only authorized users can use admin commands.";
        }

        return `
╭─〔 ⚡ ADMIN 〕─╮
│ :kick <user>
│ :mod add <user>
│ :mod remove <user>
│ :mod list
╰─〔 AUTHORIZED USERS ONLY 〕─╯
`;
    }

    // --------------------------------------------
    // MOD
    // --------------------------------------------

    if (main === "mod") {
        if (!isOwner(sender)) {
            return "Only Father and Co-Creator can manage mods.";
        }

        const sub = args[1];
        const target = args[2];

        if (
            sub === "add" &&
            target
        ) {
            if (!MODS.includes(target)) {
                MODS.push(target);
            }

            saveData();

            return `Added ${target} as a mod.`;
        }

        if (
            sub === "remove" &&
            target
        ) {
            MODS = MODS.filter(
                mod => mod !== target
            );

            saveData();

            return `Removed ${target} from mods.`;
        }

        if (sub === "list") {
            return (
                `MODS: ` +
                `${MODS.join(", ") || "none"}`
            );
        }

        return (
            "Usage: :mod add <user>, " +
            ":mod remove <user>, " +
            ":mod list"
        );
    }

    // --------------------------------------------
    // KICK MARKER
    // --------------------------------------------

    if (main === "kick") {
        if (!isAdmin(sender)) {
            return "Only admins can use that.";
        }

        const target = args[1];

        if (!target) {
            return "Usage: :kick <user>";
        }

        return (
            `⚠️ ${target} has been ` +
            `marked for removal.`
        );
    }

    return (
        `Unknown command: ${main}. ` +
        `Type :help.`
    );
}

// ============================================================
// WHATSAPP CONNECTION
// ============================================================

let reconnectTimer = null;
let activeSocket = null;

function scheduleReconnect() {
    if (reconnectTimer) {
        return;
    }

    console.log("🔄 Reconnect scheduled in 5 seconds...");

    reconnectTimer = setTimeout(() => {
        reconnectTimer = null;
        connectToWhatsApp();
    }, 5000);
}

async function connectToWhatsApp() {
    try {
        console.log("");
        console.log("====================================");
        console.log("📱 HODEKAI WHATSAPP CONNECTION");
        console.log("====================================");
        console.log(
            "📱 Bot number: " +
            BOT_NUMBER
        );
        console.log(
            "📱 Starting WhatsApp connection..."
        );

        const {
            state,
            saveCreds
        } = await useMultiFileAuthState(
            AUTH_DIR
        );

        const {
            version
        } = await fetchLatestBaileysVersion();

        const sock = makeWASocket({
            version,

            auth: state,

            keepAliveIntervalMs: 30000,

            markOnlineOnConnect: true,

            syncFullHistory: false,

            generateHighQualityLinkPreview: false
        });

        activeSocket = sock;

        // IMPORTANT:
        // Save credentials immediately whenever Baileys
        // updates them.
        sock.ev.on(
            "creds.update",
            saveCreds
        );

        // ====================================================
        // CONNECTION UPDATE
        // ====================================================

        let pairingRequested = false;

        sock.ev.on(
            "connection.update",
            async update => {
                const {
                    connection,
                    lastDisconnect
                } = update;

                // ------------------------------------------------
                // PAIRING CODE
                // ------------------------------------------------

                if (
                    !state.creds.registered &&
                    !pairingRequested
                ) {
                    pairingRequested = true;

                    setTimeout(
                        async () => {
                            try {
                                if (
                                    state.creds.registered
                                ) {
                                    return;
                                }

                                console.log("");
                                console.log(
                                    "🔑 REQUESTING HODEKAI LOGIN CODE..."
                                );

                                const code =
                                    await sock.requestPairingCode(
                                        BOT_NUMBER
                                    );

                                console.log("");
                                console.log(
                                    "╔════════════════════════════════╗"
                                );
                                console.log(
                                    "║     🔐 HODEKAI LOGIN CODE      ║"
                                );
                                console.log(
                                    "╠════════════════════════════════╣"
                                );
                                console.log(
                                    `║        ${code}                 ║`
                                );
                                console.log(
                                    "╠════════════════════════════════╣"
                                );
                                console.log(
                                    "║ WhatsApp → Linked Devices      ║"
                                );
                                console.log(
                                    "║ → Link with phone number       ║"
                                );
                                console.log(
                                    "╚════════════════════════════════╝"
                                );
                                console.log("");
                            } catch (error) {
                                console.error(
                                    "❌ Pairing code error:",
                                    error.message
                                );
                            }
                        },
                        2000
                    );
                }

                // ------------------------------------------------
                // CONNECTION OPEN
                // ------------------------------------------------

                if (connection === "open") {
                    console.log("");
                    console.log(
                        "╔════════════════════════════════════╗"
                    );
                    console.log(
                        "║       🖤 HODEKAI CONNECTED         ║"
                    );
                    console.log(
                        "╠════════════════════════════════════╣"
                    );
                    console.log(
                        "║ WhatsApp connection: ONLINE        ║"
                    );
                    console.log(
                        "║ Conclave systems: ACTIVE          ║"
                    );
                    console.log(
                        "╚════════════════════════════════════╝"
                    );
                    console.log("");
                }

                // ------------------------------------------------
                // CONNECTION CLOSED
                // ------------------------------------------------

                if (connection === "close") {
                    const statusCode =
                        lastDisconnect
                            ?.error
                            ?.output
                            ?.statusCode;

                    console.log("");
                    console.log(
                        "⚠️ WhatsApp connection closed."
                    );

                    console.log(
                        "📛 Status code:",
                        statusCode || "unknown"
                    );

                    const loggedOut =
                        statusCode ===
                        DisconnectReason.loggedOut;

                    if (loggedOut) {
                        console.log(
                            "🚪 WhatsApp session logged out."
                        );

                        console.log(
                            "🧹 Delete auth_info_baileys and pair again."
                        );

                        return;
                    }

                    // 515 / restartRequired is allowed to reconnect.
                    if (
                        statusCode ===
                        DisconnectReason.restartRequired
                    ) {
                        console.log(
                            "🔄 WhatsApp requested a restart."
                        );
                    } else {
                        console.log(
                            "🔄 Connection lost. Reconnecting..."
                        );
                    }

                    if (
                        activeSocket === sock
                    ) {
                        activeSocket = null;
                    }

                    scheduleReconnect();
                }
            }
        );

        // ====================================================
        // INCOMING MESSAGES
        // ====================================================

        sock.ev.on(
            "messages.upsert",
            async ({ messages }) => {
                for (const msg of messages) {
                    try {
                        if (!msg.message) {
                            continue;
                        }

                        if (
                            msg.key.fromMe
                        ) {
                            continue;
                        }

                        const remoteJid =
                            msg.key.remoteJid;

                        if (!remoteJid) {
                            continue;
                        }

                        // Correct sender handling:
                        // DMs use remoteJid.
                        // Groups use participant.
                        const senderJid =
                            msg.key.participant ||
                            remoteJid;

                        const sender =
                            senderJid
                                .split("@")[0]
                                .replace(
                                    /\D/g,
                                    ""
                                );

                        const messageContent =
                            msg.message;

                        let text = "";

                        if (
                            messageContent
                                .conversation
                        ) {
                            text =
                                messageContent.conversation;
                        } else if (
                            messageContent
                                .extendedTextMessage
                                ?.text
                        ) {
                            text =
                                messageContent
                                    .extendedTextMessage
                                    .text;
                        } else if (
                            messageContent
                                .imageMessage
                                ?.caption
                        ) {
                            text =
                                messageContent
                                    .imageMessage
                                    .caption;
                        } else if (
                            messageContent
                                .videoMessage
                                ?.caption
                        ) {
                            text =
                                messageContent
                                    .videoMessage
                                    .caption;
                        }

                        if (!text) {
                            continue;
                        }

                        console.log("");
                        console.log(
                            "📩 MESSAGE RECEIVED"
                        );
                        console.log(
                            "FROM:",
                            sender
                        );
                        console.log(
                            "TEXT:",
                            text
                        );

                        const reply =
                            await handleMessage(
                                text,
                                sender,
                                sock,
                                remoteJid
                            );

                        // Don't send undefined/null replies.
                        if (
                            typeof reply !==
                                "string" ||
                            !reply.trim()
                        ) {
                            continue;
                        }

                        await sock.sendMessage(
                            remoteJid,
                            {
                                text: reply
                            }
                        );

                        console.log(
                            "✅ Reply sent."
                        );

                    } catch (error) {
                        console.error(
                            "❌ Error handling message:",
                            error.message
                        );
                    }
                }
            }
        );

    } catch (error) {
        console.error("");
        console.error(
            "❌ WhatsApp startup error:",
            error.message
        );

        console.error(
            "🔄 Retrying in 5 seconds..."
        );

        scheduleReconnect();
    }
}

// ============================================================
// PROCESS HANDLERS
// ============================================================

process.on(
    "SIGINT",
    () => {
        console.log(
            "\n🛑 HODEKAI shutting down..."
        );

        saveData();

        process.exit(0);
    }
);

process.on(
    "SIGTERM",
    () => {
        console.log(
            "\n🛑 HODEKAI received SIGTERM..."
        );

        saveData();

        process.exit(0);
    }
);

process.on(
    "uncaughtException",
    error => {
        console.error(
            "💥 UNCAUGHT EXCEPTION:",
            error
        );

        saveData();

        // Let Render restart the process cleanly.
        process.exit(1);
    }
);

process.on(
    "unhandledRejection",
    error => {
        console.error(
            "💥 UNHANDLED REJECTION:",
            error
        );
    }
);

