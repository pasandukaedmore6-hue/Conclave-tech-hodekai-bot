// ============================================================
// BOT DATA
// ============================================================

let USERS = {};
let GUILDS = {};
let COMPANIES = {};
let BANK = {};
let COOLDOWNS = {};
let SUGGESTIONS = {};

let GOVERNMENT_FUNDS = 0;
let BOT_ACTIVE = true;

let SUGGESTION_ID = 1;
let JOB_ID_COUNTER = 1;
let COMMAND_COUNTER = 0;

// ============================================================
// LOAD DATA
// ============================================================

function loadData() {
    if (!fs.existsSync(DATA_FILE)) {
        console.log("📁 No existing Conclave data found. Starting fresh.");
        return;
    }

    try {
        const data = JSON.parse(
            fs.readFileSync(DATA_FILE, "utf8")
        );

        USERS = data.USERS || {};
        GUILDS = data.GUILDS || {};
        COMPANIES = data.COMPANIES || {};
        BANK = data.BANK || {};
        COOLDOWNS = data.COOLDOWNS || {};
        SUGGESTIONS = data.SUGGESTIONS || {};

        GOVERNMENT_FUNDS = Number(data.GOVERNMENT_FUNDS) || 0;
        BOT_ACTIVE =
            typeof data.BOT_ACTIVE === "boolean"
                ? data.BOT_ACTIVE
                : true;

        SUGGESTION_ID = Number(data.SUGGESTION_ID) || 1;
        JOB_ID_COUNTER = Number(data.JOB_ID_COUNTER) || 1;
        COMMAND_COUNTER = Number(data.COMMAND_COUNTER) || 0;

        // Repair old user records
        for (const [number, user] of Object.entries(USERS)) {
            if (!user || typeof user !== "object") {
                delete USERS[number];
                continue;
            }

            user.xenoShards = Number(user.xenoShards) || 0;
            user.bank = Number(user.bank) || 0;
            user.wins = Number(user.wins) || 0;

            user.role = user.role || "MEMBER";
            user.joinDate =
                user.joinDate ||
                user.joinDtae ||
                new Date().toDateString();

            delete user.joinDtae;
        }

        console.log("📂 Conclave data loaded.");
    } catch (error) {
        console.error(
            "❌ Could not load Conclave data:",
            error.message
        );
    }
}

// ============================================================
// SAVE DATA
// ============================================================

function saveData() {
    const data = {
        USERS,
        GUILDS,
        COMPANIES,
        BANK,
        COOLDOWNS,
        SUGGESTIONS,
        GOVERNMENT_FUNDS,
        BOT_ACTIVE,
        SUGGESTION_ID,
        JOB_ID_COUNTER,
        COMMAND_COUNTER
    };

    try {
        fs.writeFileSync(
            DATA_FILE,
            JSON.stringify(data, null, 2)
        );
    } catch (error) {
        console.error(
            "❌ Could not save Conclave data:",
            error.message
        );
    }
}

// ============================================================
// BASIC HELPERS
// ============================================================

function random(array) {
    return array[Math.floor(Math.random() * array.length)];
}

function getMixedResponse() {
    const responses = [
        "another day in the Conclave.",
        "HODEKAI is watching. 👀",
        "keep the chaos organized.",
        "system status: unnecessarily dramatic.",
        "the paperwork continues.",
        "Conclave operations remain operational.",
        "that was a very serious command. probably.",
        "processing... with questionable confidence.",
        "all systems nominal. 🖤",
        "HODEKAI has entered the chat."
    ];

    return random(responses);
}

function parseAmount(value) {
    const amount = Number(value);

    if (
        !Number.isInteger(amount) ||
        amount <= 0
    ) {
        return null;
    }

    return amount;
}

// ============================================================
// USER SYSTEM
// ============================================================

const STARTING_XS = 1000;
const DAILY_XS = 100;
const FINE = 500;

const OWNER_NUMBERS = {
    FATHER: "263787876771",
    CO_CREATOR: "26378787677"
};

let MODS = [
    "2348123885002",
    "2349168527304",
    "2348150350359"
];

function getRole(number) {
    if (number === OWNER_NUMBERS.FATHER) {
        return "FATHER";
    }

    if (number === OWNER_NUMBERS.CO_CREATOR) {
        return "CO_CREATOR";
    }

    if (MODS.includes(number)) {
        return "MOD";
    }

    return "MEMBER";
}

function getUser(number) {
    if (
        !USERS[number] ||
        typeof USERS[number] !== "object"
    ) {
        USERS[number] = {
            xenoShards: STARTING_XS,
            bank: 0,
            role: getRole(number),
            joinDate: new Date().toDateString(),
            wins: 0,
            lastDaily: 0
        };
    } else {
        USERS[number].role = getRole(number);
    }

    return USERS[number];
}

function giveXenoShards(number, amount) {
    if (
        !Number.isFinite(amount) ||
        amount <= 0
    ) {
        return false;
    }

    getUser(number).xenoShards += amount;

    return true;
}

function takeXenoShards(number, amount) {
    const user = getUser(number);

    if (
        !Number.isFinite(amount) ||
        amount <= 0
    ) {
        return false;
    }

    if (user.xenoShards < amount) {
        return false;
    }

    user.xenoShards -= amount;

    return true;
}

// ============================================================
// ROLE CHECKS
// ============================================================

function isOwner(number) {
    return (
        number === OWNER_NUMBERS.FATHER ||
        number === OWNER_NUMBERS.CO_CREATOR
    );
}

function isAdmin(number) {
    return (
        isOwner(number) ||
        MODS.includes(number)
    );
}

// ============================================================
// STATS
// ============================================================

function getTotalMembers() {
    return Object.keys(USERS).length;
}

function getStats() {
    return {
        members: Object.keys(USERS).length,
        guilds: Object.keys(GUILDS).length,
        companies: Object.keys(COMPANIES).length
    };
}

